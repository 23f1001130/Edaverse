[Unit]
Description=Dataflow FastAPI Backend
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/dataflow-backend
Environment="PATH=/var/www/dataflow-backend/venv/bin"
ExecStart=/var/www/dataflow-backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
